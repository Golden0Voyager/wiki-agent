# ============================================================
# WikiAgent — API Key 配置示例
# 复制本文件为 .env 并填入你的 Key（逗号分隔多个 Key）
# 不需要全部配置，系统会自动检测可用 Provider
# ============================================================

# ── NVIDIA NIM (build.nvidia.com) ──
# 免费 tier: 40 RPM, ~1,000 req/month
# 支持模型: Qwen3-480B, Mistral-675B, Minimax-M2.7, Llama-70B, Gemma-31B
NVIDIA_API_KEY=nvapi-xxxxxxxx

# ── Groq (console.groq.com) ──
# 慷慨免费层，LPU 架构极速推理
GROQ_API_KEY=gsk_xxxxxxxx

# ── ModelScope (modelscope.cn) ──
# 每日 2,000 次免费请求
MODELSCOPE_API_KEY=xxxxxxxx

# ── AIHubMix (aihubmix.com) ──
# 免费模型池: GPT-4.1, Kimi-K2.6, GLM-5.1 等
AIHUBMIX_API_KEY=sk-xxxxxxxx

# ── OpenRouter (openrouter.ai) ──
# 每日免费限额，自动获取 :free 模型
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx

# ── ZhipuAI (open.bigmodel.cn) ──
# 免费额度，支持双账号
ZHIPUAI_API_KEY=xxxxxxxx.xxxxxxxxxxxx
ZHIPUAI_API_KEY_BACKUP=xxxxxxxx.xxxxxxxxxxxx

# ── Tencent Hunyuan ──
# hunyuan-lite 永久免费
HUNYUAN_API_KEY=xxxxxxxx

# ── Tencent TokenHub (tokenhub.tencentmaas.com) ──
# hy3-preview: 100万免费 token
TOKENHUB_API_KEY=xxxxxxxx

# ── Google Gemini ──
GEMINI_API_KEY=AIzaSyxxxxxxxx

# ── SiliconFlow ──
SILICONFLOW_API_KEY=sk-xxxxxxxx

# ── 兼容旧配置 ──
AI_API_KEY=xxxxxxxx
